decimal64 = [coefficient: int, exponent10: -18..18]
cursor = [evidence-sequence: uint, message-ordinal: uint]
profile-key = [fid: tstr .size (1..64), realm: 0..3, save-epoch: uint]

host-message = set-role / apply-observation-v1 / apply-observation-v2
set-role = { 0: 1, 1: uint, 2: 0..1 }
apply-observation-v1 = {
  0: 2, 1: 1, 2: cursor, 3: bstr .size 32, 4: bstr .size 16,
  5: profile-key, 6: 1..2, 7: int / null, 8: int, 9: int,
  10: 1..65535, 11: any, 12: 0..5
}
apply-observation-v2 = {
  0: 2, 1: 2, 2: cursor, 3: bstr .size 32, 4: bstr .size 16,
  5: profile-key, 6: 1..3, 7: int / null, 8: int, 9: int,
  10: 1..65535, 11: observation-payload-v2, 12: 0..6
}

observation-payload-v2 = null / fsdjump-payload / commander-vessel-payload

; R0 v2 kind 1 (SessionBound) uses null payload.
; R0 v2 kind 2 (FsdJump) uses fsdjump-payload.
; R0 v2 kind 3 (CommanderVessel) carries only the six selected profile facts.
fsdjump-payload = {
  0: tstr .size (1..128), 1: uint,
  2: [decimal64, decimal64, decimal64],
  3: decimal64, 4: decimal64, 5: decimal64
}

commander-vessel-payload = {
  0: tstr .size (1..128), ; commander.name, internal UTF-8 byte bound
  1: bool,                ; commander.alive
  2: bool,                ; commander.docked
  3: bool,                ; commander.onfoot
  4: tstr .size (1..128), ; ship.name, internal UTF-8 byte bound
  5: bool                 ; ship.alive
}

kernel-response-v1 = {
  0: 1..2,              ; 1=RoleResponse, 2=ApplyResponse
  1: 0..6,              ; status
  2: uint,              ; authority epoch
  3: cursor / null,
  4: bstr .size 32,     ; authoritative state SHA-256
  5: jump-fact / null,
  6: 0..1                ; self-reported kernel role: 0=Shadow, 1=Active
}

kernel-response-v2 = {
  0: 1..2,              ; 1=RoleResponse, 2=ApplyResponse
  1: 0..6,              ; status
  2: uint,              ; authority epoch
  3: cursor / null,
  4: bstr .size 32,     ; authoritative state SHA-256
  5: jump-fact / null,
  6: 0..1,               ; self-reported kernel role: 0=Shadow, 1=Active
  7: commander-vessel-fact / null
}

kernel-response = kernel-response-v1 / kernel-response-v2

jump-fact = [
  cursor, uint, tstr .size (1..128),
  [decimal64, decimal64, decimal64],
  decimal64, decimal64, decimal64,
  0..5, 0..3, 0..5, 0..3
]

commander-vessel-fact = [
  cursor,
  tstr .size (1..128), ; CommanderName
  bool,                 ; commander.alive
  bool,                 ; commander.docked
  bool,                 ; commander.onfoot
  tstr .size (1..128), ; VesselName
  bool,                 ; ship.alive
  3 / 6,                ; FrontierApi or explicit Sample provenance
  1                     ; Current freshness
]
