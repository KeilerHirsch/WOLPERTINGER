with "aunit";
with "../wolpertinger_kernel.gpr";

project Wolpertinger_Kernel_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("wolpertinger_kernel_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa");
   end Compiler;
end Wolpertinger_Kernel_Tests;
