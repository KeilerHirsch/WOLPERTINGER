<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wolpertinger.Presentation.ViewModels"
        x:Class="Wolpertinger.Presentation.App.Views.OverlayWindow"
        x:DataType="vm:JumpViewModel" Title="WOLPERTINGER Overlay"
        Width="300" Height="480">
  <StackPanel Margin="16" Spacing="10" IsHitTestVisible="False">
    <TextBlock Text="WOLPERTINGER" FontWeight="Bold" />
    <TextBlock x:Name="EmptyState" Text="Connecting — no validated jump available" TextWrapping="Wrap" />
    <StackPanel x:Name="Body" IsVisible="False" Spacing="8">
      <TextBlock Text="System" />
      <TextBlock Text="{Binding StarSystem}" FontSize="22" TextWrapping="Wrap" />
      <TextBlock Text="Jump distance" />
      <TextBlock Text="{Binding JumpDistanceText}" />
      <TextBlock Text="Remaining fuel" />
      <TextBlock Text="{Binding FuelLevelText}" />
      <TextBlock Text="{Binding AvailabilityText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding LocationStatusText, StringFormat='Location: {0}'}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding FuelStatusText, StringFormat='Fuel: {0}'}" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</Window>
