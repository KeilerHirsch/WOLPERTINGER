<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wolpertinger.Presentation.ViewModels"
        x:Class="Wolpertinger.Presentation.App.Views.OverlayWindow"
        x:DataType="vm:JumpViewModel" Title="WOLPERTINGER Overlay"
        Width="300" Height="480">
  <StackPanel Margin="16" Spacing="6" IsHitTestVisible="False">
    <TextBlock x:Name="EmptyState" Text="Connecting — no validated jump available" TextWrapping="Wrap" />
    <StackPanel x:Name="Body" IsVisible="False" Spacing="6">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="WOLPERTINGER" FontWeight="Bold" />
        <TextBlock Grid.Column="1" Text="{Binding AvailabilityText}" HorizontalAlignment="Right" />
      </Grid>
      <TextBlock Text="{Binding StarSystem}" FontSize="22" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding JumpDistanceText, StringFormat='Jump: {0}'}" />
        <TextBlock Text="{Binding FuelLevelText, StringFormat='Fuel: {0}'}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding LocationStatusText, StringFormat='Location: {0}'}" />
        <TextBlock Text="{Binding FuelStatusText, StringFormat='Fuel: {0}'}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
